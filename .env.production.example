# ============================================================
# SABO — PRODUCTION VM ENVIRONMENT (Oracle Cloud / any Docker VM)
# Copy to .env.production on the VM and adjust values. NEVER commit
# the real .env.production file.
# ============================================================

# Your domain, pointed (A record) at the VM's public IP.
# Free option: a DuckDNS subdomain, e.g. sabo.duckdns.org
DOMAIN=sabo.duckdns.org

# PostgreSQL
POSTGRES_USER=sabo
POSTGRES_PASSWORD=replace_with_a_strong_database_password
POSTGRES_DB=sabo_db

# JWT secrets (different from each other, 32+ chars)
JWT_ACCESS_SECRET=replace_with_a_random_32plus_char_access_secret
JWT_REFRESH_SECRET=replace_with_a_different_random_32plus_char_refresh_secret

# First SUPER_ADMIN login (change ADMIN_BOOTSTRAP_PASSWORD after first login)
ADMIN_BOOTSTRAP_EMAIL=admin@sabo.uz
ADMIN_BOOTSTRAP_PASSWORD=replace_with_a_strong_admin_password
