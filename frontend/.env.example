# ============================================================
# SABO FRONTEND — ENVIRONMENT VARIABLES (Railway & Production)
# ============================================================

# Public API URL of the NestJS Backend (used by browser client)
# On Railway: https://${{backend.RAILWAY_PUBLIC_DOMAIN}}/api/v1 or your custom domain
NEXT_PUBLIC_API_URL=https://api.sabo.uz/api/v1

# Production Website URL for Canonical, OpenGraph and Sitemap generation
# On Railway: https://${{RAILWAY_PUBLIC_DOMAIN}} or https://sabo.uz
NEXT_PUBLIC_SITE_URL=https://sabo.uz

# Internal API URL for Server-Side Rendering (optional, defaults to NEXT_PUBLIC_API_URL)
INTERNAL_API_URL=https://api.sabo.uz/api/v1
