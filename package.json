{
  "name": "sabo-platform",
  "version": "1.0.0",
  "private": true,
  "description": "SABO Dairy Platform — Fullstack Monorepo (Next.js Frontend + NestJS Backend with React Vite Admin Panel)",
  "workspaces": [
    "frontend",
    "backend",
    "backend/admin"
  ],
  "scripts": {
    "dev": "node ./node_modules/concurrently/dist/bin/concurrently.js -n backend,frontend,admin -c green,blue,magenta \"npm run dev --prefix backend\" \"npm run dev --prefix frontend\" \"npm run dev --prefix backend/admin\"",
    "dev:frontend": "npm run dev --prefix frontend",
    "dev:admin": "npm run dev --prefix backend/admin",
    "dev:backend": "npm run dev --prefix backend",
    "build": "npm run build --prefix backend && npm run build --prefix frontend && npm run build --prefix backend/admin",
    "build:frontend": "npm run build --prefix frontend",
    "build:admin": "npm run build --prefix backend/admin",
    "build:backend": "npm run build --prefix backend",
    "install:all": "npm install",
    "lint": "npm run lint --prefix frontend && npm run lint --prefix backend",
    "lint:frontend": "npm run lint --prefix frontend",
    "lint:backend": "npm run lint --prefix backend",
    "typecheck": "npm run typecheck --prefix backend",
    "prisma:generate": "npm run prisma:generate --prefix backend",
    "prisma:migrate": "npm run prisma:migrate --prefix backend",
    "prisma:seed": "npm run prisma:seed --prefix backend",
    "prisma:studio": "npm run prisma:studio --prefix backend",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down"
  },
  "devDependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.2.4",
    "oxlint": "^1.75.0",
    "vite": "^6.2.0"
  },
  "keywords": [
    "sabo",
    "nextjs",
    "vite",
    "react",
    "nestjs",
    "prisma",
    "postgresql",
    "redis"
  ],
  "author": "SABO Team",
  "license": "UNLICENSED"
}
