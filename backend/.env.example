# ============================================================
# SABO BACKEND — ENVIRONMENT VARIABLES
# ============================================================

# App Configuration
NODE_ENV=development
PORT=4000
API_PREFIX=api/v1
APP_NAME=SABO-API
DEFAULT_LOCALE=uz
SUPPORTED_LOCALES=uz,ru,en

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sabo_db?schema=public&connection_limit=20&pool_timeout=10"

# Cache & Rate Limiting (Redis)
REDIS_URL="redis://localhost:6379"

# Authentication & JWT
JWT_ACCESS_SECRET=your_super_secret_access_jwt_key_change_in_production_min_32_chars
JWT_REFRESH_SECRET=your_super_secret_refresh_jwt_key_change_in_production_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS & Security
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000

# S3 / MinIO Object Storage
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=sabo-media
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_URL=http://localhost:9000/sabo-media

# Email (SMTP / Mailpit for Dev)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="SABO Dairy <noreply@sabo.uz>"

# Payments (Click & Payme)
CLICK_API_URL=https://api.click.uz/v2/merchant
CLICK_MERCHANT_ID=
CLICK_SERVICE_ID=
CLICK_SECRET=
PAYME_API_URL=https://checkout.paycom.uz/api
PAYME_MERCHANT_ID=
PAYME_SECRET=

# Feature Flags
ECOMMERCE_ENABLED=true
CART_ENABLED=true
CHECKOUT_ENABLED=true
PAYMENTS_ENABLED=true
BLOG_ENABLED=true
REGISTRATION_ENABLED=true
THREE_D_ENABLED=true
