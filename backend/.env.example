# ============================================================
# SABO BACKEND — ENVIRONMENT VARIABLES (EXAMPLE)
# Copy to .env and fill in real values. NEVER commit the real .env file.
# ============================================================

NODE_ENV=development
PORT=4000
API_PREFIX=api/v1
APP_NAME=SABO-API
DEFAULT_LOCALE=uz
SUPPORTED_LOCALES=uz,ru,en

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sabo?schema=public&connection_limit=20&pool_timeout=10

# Cache & Rate Limiting (Redis)
REDIS_URL=redis://localhost:6379

# Authentication & JWT
# Generate strong random secrets, e.g.: openssl rand -base64 32
# Must be at least 32 characters in production (see src/config/validation.ts) and DIFFERENT from each other.
JWT_ACCESS_SECRET=replace_with_a_random_32plus_char_secret
JWT_REFRESH_SECRET=replace_with_a_different_random_32plus_char_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Initial Super Admin Bootstrapping (used by prisma/seed.ts and docker-entrypoint.sh)
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_PASSWORD=replace_with_a_strong_password

# CORS & Frontend URLs
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Object storage (S3 / MinIO) for media uploads
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=sabo-media
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_URL=http://localhost:9000/sabo-media

# SMTP (email)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=SABO Dairy <noreply@example.com>

# Payment providers
CLICK_API_URL=https://api.click.uz/v2/merchant
CLICK_MERCHANT_ID=
CLICK_SERVICE_ID=
CLICK_SECRET=
PAYME_API_URL=https://checkout.paycom.uz/api
PAYME_MERCHANT_ID=
PAYME_SECRET=

# Feature Flags
ECOMMERCE_ENABLED=true
CART_ENABLED=true
CHECKOUT_ENABLED=true
PAYMENTS_ENABLED=true
BLOG_ENABLED=true
REGISTRATION_ENABLED=true
THREE_D_ENABLED=true
