# ============================================================
# SABO BACKEND — ENVIRONMENT VARIABLES (Railway & Production)
# ============================================================

# App Configuration
NODE_ENV=production
PORT=4000
API_PREFIX=api/v1
APP_NAME=SABO-API
DEFAULT_LOCALE=uz
SUPPORTED_LOCALES=uz,ru,en

# Database (PostgreSQL - On Railway: automatically provided via ${{Postgres.DATABASE_URL}})
DATABASE_URL="postgresql://postgres:password@host:5432/railway?schema=public&connection_limit=20&pool_timeout=10"

# Cache & Rate Limiting (Redis - On Railway: provided via ${{Redis.REDIS_URL}} or left blank for in-memory fallback)
REDIS_URL="redis://default:password@host:6379"

# Authentication & JWT (MUST be at least 32 characters in production)
JWT_ACCESS_SECRET=sabo_secure_jwt_access_secret_production_key_minimum_32_chars_2026
JWT_REFRESH_SECRET=sabo_secure_jwt_refresh_secret_production_key_minimum_32_chars_2026
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Initial Super Admin Bootstrapping
ADMIN_BOOTSTRAP_EMAIL=admin@sabo.uz
ADMIN_BOOTSTRAP_PASSWORD=Admin0525

# CORS & Security (Include your Railway frontend URL and custom domains)
FRONTEND_URL=https://sabo.uz
CORS_ORIGINS=https://sabo.uz,https://*.up.railway.app,http://localhost:3000

# S3 / MinIO Object Storage (Optional: AWS S3 or Cloudflare R2)
S3_ENDPOINT=https://s3.amazonaws.com
S3_REGION=us-east-1
S3_BUCKET=sabo-media
S3_ACCESS_KEY=your_access_key
S3_SECRET_KEY=your_secret_key
S3_FORCE_PATH_STYLE=false
S3_PUBLIC_URL=https://sabo-media.s3.amazonaws.com

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=info@sabo.uz
SMTP_PASSWORD=your_app_password
EMAIL_FROM="SABO Dairy <noreply@sabo.uz>"

# Payments (Click & Payme)
CLICK_API_URL=https://api.click.uz/v2/merchant
CLICK_MERCHANT_ID=
CLICK_SERVICE_ID=
CLICK_SECRET=
PAYME_API_URL=https://checkout.paycom.uz/api
PAYME_MERCHANT_ID=
PAYME_SECRET=

# Feature Flags
ECOMMERCE_ENABLED=true
CART_ENABLED=true
CHECKOUT_ENABLED=true
PAYMENTS_ENABLED=true
BLOG_ENABLED=true
REGISTRATION_ENABLED=true
THREE_D_ENABLED=true
