datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ============================================================
// ENUMS
// ============================================================

enum RoleType {
  SUPER_ADMIN
  ADMIN
  EDITOR
  MANAGER
  CUSTOMER
  MODERATOR
}

enum ProductStatus {
  DRAFT
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum ProductImageType {
  PRIMARY
  GALLERY
  LIFESTYLE
  DETAIL
  THUMBNAIL
}

enum AvailabilityStatus {
  AVAILABLE
  UNAVAILABLE
  COMING_SOON
  HIDDEN
}

enum BlogStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ContactMessageStatus {
  NEW
  READ
  IN_PROGRESS
  RESOLVED
  SPAM
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  READY
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  FAILED
}

enum PaymentStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
  REFUNDED
}

enum FulfillmentStatus {
  UNFULFILLED
  PROCESSING
  FULFILLED
  RETURNED
}

enum PaymentProviderType {
  CLICK
  PAYME
  CASH
  MANUAL
}

enum PaymentTransactionType {
  INITIATE
  PREPARE
  COMPLETE
  CANCEL
  REFUND
}

enum NotificationType {
  ORDER_CREATED
  ORDER_STATUS_CHANGED
  PAYMENT_SUCCESS
  PAYMENT_FAILED
  PASSWORD_CHANGED
  SYSTEM
}

enum SettingType {
  STRING
  NUMBER
  BOOLEAN
  JSON
}

// ============================================================
// USER, AUTH & RBAC
// ============================================================

model User {
  id           String    @id @default(uuid()) @db.Uuid
  email        String?   @unique
  phone        String?   @unique
  passwordHash String
  firstName    String?
  lastName     String?
  avatarId     String?   @db.Uuid
  locale       String    @default("uz")
  isActive     Boolean   @default(true)
  isVerified   Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  lastLoginAt  DateTime?
  deletedAt    DateTime?

  avatar        Media?          @relation("UserAvatar", fields: [avatarId], references: [id], onDelete: SetNull)
  userRoles     UserRole[]
  refreshTokens RefreshToken[]
  sessions      Session[]
  orders        Order[]
  notifications Notification[]
  auditLogs     AuditLog[]
  blogPosts     BlogPost[]
  cart          Cart?
  orderNotes    OrderNote[]

  @@index([email])
  @@index([phone])
  @@index([isActive])
  @@index([createdAt])
  @@map("users")
}

model Role {
  id          String    @id @default(uuid()) @db.Uuid
  name        RoleType  @unique
  description String?
  isSystem    Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  slug        String   @unique
  name        String
  description String?
  module      String
  createdAt   DateTime @default(now())

  rolePermissions RolePermission[]

  @@index([module])
  @@map("permissions")
}

model RolePermission {
  id           String   @id @default(uuid()) @db.Uuid
  roleId       String   @db.Uuid
  permissionId String   @db.Uuid
  createdAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  roleId    String   @db.Uuid
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@map("user_roles")
}

model RefreshToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  tokenHash  String    @unique
  deviceInfo String?
  ipHash     String?
  isRevoked  Boolean   @default(false)
  expiresAt  DateTime
  createdAt  DateTime  @default(now())
  revokedAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model Session {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @db.Uuid
  sessionToken String    @unique
  ipHash       String?
  userAgent    String?
  expiresAt    DateTime
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([sessionToken])
  @@map("sessions")
}

// ============================================================
// MEDIA MANAGEMENT
// ============================================================

model Media {
  id           String   @id @default(uuid()) @db.Uuid
  fileName     String
  originalName String
  mimeType     String
  size         Int
  storageKey   String   @unique
  url          String
  width        Int?
  height       Int?
  altText      String?
  folder       String   @default("general")
  createdBy    String?  @db.Uuid
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  usersAvatar         User[]            @relation("UserAvatar")
  productImages       ProductImage[]
  threeDAssets        ThreeDAsset[]     @relation("ThreeDMedia")
  categoryImages      Category[]        @relation("CategoryImage")
  blogCovers          BlogPost[]        @relation("BlogCover")
  certificateDocs     Certificate[]     @relation("CertificateDoc")
  certificatePreviews Certificate[]     @relation("CertificatePreview")
  productionHeroes    ProductionPage[]  @relation("ProductionHeroImage")
  productionSteps     ProductionStep[]  @relation("ProductionStepImage")
  aboutHeroes         AboutPage[]       @relation("AboutHeroImage")
  aboutTimelines      AboutTimeline[]   @relation("AboutTimelineImage")
  teamMembers         TeamMember[]      @relation("TeamMemberPhoto")
  homeHeroBgs         HomeHero[]        @relation("HomeHeroBg")
  homeHeroProducts    HomeHero[]        @relation("HomeHeroProduct")
  homeSections        HomeSection[]     @relation("HomeSectionImage")

  @@index([mimeType])
  @@index([folder])
  @@index([createdAt])
  @@map("media")
}

// ============================================================
// CATALOG: CATEGORIES & PRODUCTS
// ============================================================

model Category {
  id          String   @id @default(uuid()) @db.Uuid
  slug        String   @unique
  name        String
  description String?
  imageId     String?  @db.Uuid
  parentId    String?  @db.Uuid
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  image        Media?                @relation("CategoryImage", fields: [imageId], references: [id], onDelete: SetNull)
  parent       Category?             @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children     Category[]            @relation("CategoryHierarchy")
  products     Product[]
  translations CategoryTranslation[]

  @@index([slug])
  @@index([isActive])
  @@index([parentId])
  @@map("categories")
}

model CategoryTranslation {
  id          String   @id @default(uuid()) @db.Uuid
  categoryId  String   @db.Uuid
  locale      String
  name        String
  description String?

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, locale])
  @@index([locale])
  @@map("category_translations")
}

model Product {
  id               String        @id @default(uuid()) @db.Uuid
  slug             String        @unique
  status           ProductStatus @default(DRAFT)
  name             String
  description      String?
  shortDescription String?
  categoryId       String?       @db.Uuid
  brand            String?       @default("SABO")
  sku              String?       @unique
  barcode          String?
  isFeatured       Boolean       @default(false)
  isActive         Boolean       @default(true)
  sortOrder        Int           @default(0)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  publishedAt      DateTime?
  deletedAt        DateTime?

  category     Category?             @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  translations ProductTranslation[]
  images       ProductImage[]
  variants     ProductVariant[]
  nutrition    ProductNutrition?
  ingredients  ProductIngredient[]
  storage      ProductStorage?
  availability ProductAvailability?
  seo          ProductSEO[]
  threeDAsset  ThreeDAsset?
  orderItems   OrderItem[]

  @@index([slug])
  @@index([status])
  @@index([categoryId])
  @@index([isFeatured])
  @@index([isActive])
  @@index([createdAt])
  @@map("products")
}

model ProductTranslation {
  id               String   @id @default(uuid()) @db.Uuid
  productId        String   @db.Uuid
  locale           String
  name             String
  description      String?
  shortDescription String?
  ingredientsText  String?
  storageText      String?
  seoTitle         String?
  seoDescription   String?

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, locale])
  @@index([locale])
  @@index([name])
  @@map("product_translations")
}

model ProductImage {
  id        String           @id @default(uuid()) @db.Uuid
  productId String           @db.Uuid
  mediaId   String           @db.Uuid
  type      ProductImageType @default(GALLERY)
  sortOrder Int              @default(0)
  altText   String?
  isPrimary Boolean          @default(false)
  createdAt DateTime         @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  media   Media   @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([mediaId])
  @@index([isPrimary])
  @@map("product_images")
}

model ProductVariant {
  id          String   @id @default(uuid()) @db.Uuid
  productId   String   @db.Uuid
  name        String
  volume      String?
  unit        String?
  sku         String?  @unique
  barcode     String?
  priceMinor  Int?
  currency    String   @default("UZS")
  stock       Int      @default(0)
  isAvailable Boolean  @default(true)
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems  CartItem[]
  orderItems OrderItem[]

  @@index([productId])
  @@index([sku])
  @@index([isAvailable])
  @@map("product_variants")
}

model ProductNutrition {
  id             String   @id @default(uuid()) @db.Uuid
  productId      String   @unique @db.Uuid
  servingSize    String?
  calories       Float?
  protein        Float?
  fat            Float?
  carbohydrates  Float?
  sugar          Float?
  salt           Float?
  fiber          Float?
  additionalData Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_nutrition")
}

model ProductIngredient {
  id           String   @id @default(uuid()) @db.Uuid
  productId    String   @db.Uuid
  name         String
  order        Int      @default(0)
  isAllergen   Boolean  @default(false)
  allergenNote String?

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_ingredients")
}

model ProductStorage {
  id             String  @id @default(uuid()) @db.Uuid
  productId      String  @unique @db.Uuid
  temperatureMin Float?
  temperatureMax Float?
  shelfLife      String?
  storageText    String?

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_storage")
}

model ProductAvailability {
  id             String             @id @default(uuid()) @db.Uuid
  productId      String             @unique @db.Uuid
  status         AvailabilityStatus @default(AVAILABLE)
  stock          Int?
  availableFrom  DateTime?
  availableUntil DateTime?

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("product_availability")
}

model ProductSEO {
  id             String  @id @default(uuid()) @db.Uuid
  productId      String  @db.Uuid
  locale         String
  title          String?
  description    String?
  canonicalUrl   String?
  ogTitle        String?
  ogDescription  String?
  ogImageId      String? @db.Uuid
  noIndex        Boolean @default(false)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, locale])
  @@map("product_seo")
}

model ThreeDAsset {
  id            String   @id @default(uuid()) @db.Uuid
  mediaId       String   @unique @db.Uuid
  productId     String   @unique @db.Uuid
  posterImageId String?  @db.Uuid
  isActive      Boolean  @default(true)
  metadata      Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  media   Media   @relation("ThreeDMedia", fields: [mediaId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("three_d_assets")
}

// ============================================================
// CMS: PRODUCTION, ABOUT, CERTIFICATES, BLOG
// ============================================================

model ProductionPage {
  id              String   @id @default(uuid()) @db.Uuid
  status          String   @default("PUBLISHED")
  heroTitle       String?
  heroDescription String?
  heroImageId     String?  @db.Uuid
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  heroImage    Media?                  @relation("ProductionHeroImage", fields: [heroImageId], references: [id], onDelete: SetNull)
  translations ProductionTranslation[]
  steps        ProductionStep[]

  @@map("production_pages")
}

model ProductionTranslation {
  id          String  @id @default(uuid()) @db.Uuid
  pageId      String  @db.Uuid
  locale      String
  title       String?
  description String?

  page ProductionPage @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@unique([pageId, locale])
  @@map("production_translations")
}

model ProductionStep {
  id          String  @id @default(uuid()) @db.Uuid
  pageId      String  @db.Uuid
  sortOrder   Int     @default(0)
  imageId     String? @db.Uuid
  title       String
  description String?

  page  ProductionPage @relation(fields: [pageId], references: [id], onDelete: Cascade)
  image Media?          @relation("ProductionStepImage", fields: [imageId], references: [id], onDelete: SetNull)

  @@index([pageId])
  @@map("production_steps")
}

model AboutPage {
  id              String   @id @default(uuid()) @db.Uuid
  status          String   @default("PUBLISHED")
  heroTitle       String?
  heroDescription String?
  heroImageId     String?  @db.Uuid
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  heroImage    Media?             @relation("AboutHeroImage", fields: [heroImageId], references: [id], onDelete: SetNull)
  translations AboutTranslation[]
  timelines    AboutTimeline[]
  values       AboutValue[]

  @@map("about_pages")
}

model AboutTranslation {
  id          String  @id @default(uuid()) @db.Uuid
  pageId      String  @db.Uuid
  locale      String
  title       String?
  description String?

  page AboutPage @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@unique([pageId, locale])
  @@map("about_translations")
}

model AboutTimeline {
  id          String  @id @default(uuid()) @db.Uuid
  pageId      String  @db.Uuid
  year        String
  title       String
  description String?
  imageId     String? @db.Uuid
  sortOrder   Int     @default(0)

  page  AboutPage @relation(fields: [pageId], references: [id], onDelete: Cascade)
  image Media?    @relation("AboutTimelineImage", fields: [imageId], references: [id], onDelete: SetNull)

  @@index([pageId])
  @@map("about_timelines")
}

model AboutValue {
  id          String  @id @default(uuid()) @db.Uuid
  pageId      String  @db.Uuid
  title       String
  description String?
  icon        String?
  sortOrder   Int     @default(0)

  page AboutPage @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([pageId])
  @@map("about_values")
}

model TeamMember {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  position     String
  photoMediaId String?  @db.Uuid
  bio          String?
  sortOrder    Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  photo Media? @relation("TeamMemberPhoto", fields: [photoMediaId], references: [id], onDelete: SetNull)

  @@map("team_members")
}

model Certificate {
  id                String    @id @default(uuid()) @db.Uuid
  title             String
  description       String?
  documentMediaId   String?   @db.Uuid
  previewMediaId    String?   @db.Uuid
  issuedBy          String?
  certificateNumber String?
  issuedAt          DateTime?
  expiresAt         DateTime?
  isActive          Boolean   @default(true)
  sortOrder         Int       @default(0)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  documentMedia Media? @relation("CertificateDoc", fields: [documentMediaId], references: [id], onDelete: SetNull)
  previewMedia  Media? @relation("CertificatePreview", fields: [previewMediaId], references: [id], onDelete: SetNull)

  @@index([isActive])
  @@map("certificates")
}

model BlogCategory {
  id          String   @id @default(uuid()) @db.Uuid
  slug        String   @unique
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  posts        BlogPost[]
  translations BlogCategoryTranslation[]

  @@index([slug])
  @@map("blog_categories")
}

model BlogCategoryTranslation {
  id          String @id @default(uuid()) @db.Uuid
  categoryId  String @db.Uuid
  locale      String
  name        String
  description String?

  category BlogCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, locale])
  @@map("blog_category_translations")
}

model BlogPost {
  id           String     @id @default(uuid()) @db.Uuid
  slug         String     @unique
  status       BlogStatus @default(DRAFT)
  coverImageId String?    @db.Uuid
  categoryId   String?    @db.Uuid
  authorId     String?    @db.Uuid
  publishedAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  deletedAt    DateTime?

  coverImage   Media?                @relation("BlogCover", fields: [coverImageId], references: [id], onDelete: SetNull)
  category     BlogCategory?         @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  author       User?                 @relation(fields: [authorId], references: [id], onDelete: SetNull)
  translations BlogPostTranslation[]

  @@index([slug])
  @@index([status])
  @@index([publishedAt])
  @@map("blog_posts")
}

model BlogPostTranslation {
  id             String  @id @default(uuid()) @db.Uuid
  postId         String  @db.Uuid
  locale         String
  title          String
  excerpt        String?
  content        String
  seoTitle       String?
  seoDescription String?

  post BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, locale])
  @@index([locale])
  @@map("blog_post_translations")
}

// ============================================================
// CONTACT & MESSAGES
// ============================================================

model ContactMessage {
  id         String               @id @default(uuid()) @db.Uuid
  name       String
  phone      String?
  email      String?
  message    String
  status     ContactMessageStatus @default(NEW)
  ipHash     String?
  userAgent  String?
  adminNotes String?
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt

  @@index([status])
  @@index([createdAt])
  @@map("contact_messages")
}

model SiteContact {
  id           String   @id @default(uuid()) @db.Uuid
  phone        String?
  email        String?
  address      String?
  workingHours String?
  mapUrl       String?
  latitude     Float?
  longitude    Float?
  socialLinks  Json?
  updatedAt    DateTime @updatedAt

  @@map("site_contacts")
}

// ============================================================
// E-COMMERCE: CART, ORDERS, ADDRESS & PAYMENTS
// ============================================================

model Cart {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @unique @db.Uuid
  sessionId String?  @unique
  currency  String   @default("UZS")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@index([userId])
  @@index([sessionId])
  @@map("carts")
}

model CartItem {
  id               String   @id @default(uuid()) @db.Uuid
  cartId           String   @db.Uuid
  productVariantId String   @db.Uuid
  quantity         Int      @default(1)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  cart    Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Cascade)

  @@unique([cartId, productVariantId])
  @@index([cartId])
  @@map("cart_items")
}

model Order {
  id                String            @id @default(uuid()) @db.Uuid
  orderNumber       String            @unique
  userId            String?           @db.Uuid
  status            OrderStatus       @default(PENDING)
  paymentStatus     PaymentStatus     @default(PENDING)
  fulfillmentStatus FulfillmentStatus @default(UNFULFILLED)
  currency          String            @default("UZS")
  subtotalMinor     Int
  discountMinor     Int               @default(0)
  deliveryMinor     Int               @default(0)
  taxMinor          Int               @default(0)
  totalMinor        Int
  customerName      String
  customerPhone     String
  customerEmail     String?
  note              String?
  idempotencyKey    String?           @unique
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  cancelledAt       DateTime?
  completedAt       DateTime?

  user      User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  items     OrderItem[]
  address   OrderAddress?
  payments  Payment[]
  notes     OrderNote[]

  @@index([orderNumber])
  @@index([userId])
  @@index([status])
  @@index([paymentStatus])
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id             String   @id @default(uuid()) @db.Uuid
  orderId        String   @db.Uuid
  productId      String?  @db.Uuid
  variantId      String?  @db.Uuid
  productName    String
  variantName    String?
  sku            String?
  quantity       Int
  unitPriceMinor Int
  subtotalMinor  Int
  currency       String   @default("UZS")
  createdAt      DateTime @default(now())

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@map("order_items")
}

model OrderAddress {
  id            String  @id @default(uuid()) @db.Uuid
  orderId       String  @unique @db.Uuid
  recipientName String
  phone         String
  country       String? @default("Uzbekistan")
  region        String?
  city          String?
  district      String?
  street        String?
  building      String?
  apartment     String?
  postalCode    String?
  deliveryNote  String?

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("order_addresses")
}

model OrderNote {
  id                String   @id @default(uuid()) @db.Uuid
  orderId           String   @db.Uuid
  authorId          String?  @db.Uuid
  content           String
  isCustomerVisible Boolean  @default(false)
  createdAt         DateTime @default(now())

  order  Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  author User? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@map("order_notes")
}

model Payment {
  id                    String              @id @default(uuid()) @db.Uuid
  orderId               String              @db.Uuid
  provider              PaymentProviderType
  status                PaymentStatus       @default(PENDING)
  amountMinor           Int
  currency              String              @default("UZS")
  externalTransactionId String?             @unique
  paymentUrl            String?
  metadata              Json?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  order        Order                @relation(fields: [orderId], references: [id], onDelete: Restrict)
  transactions PaymentTransaction[]

  @@index([orderId])
  @@index([provider])
  @@index([status])
  @@index([externalTransactionId])
  @@map("payments")
}

model PaymentTransaction {
  id           String                 @id @default(uuid()) @db.Uuid
  paymentId    String                 @db.Uuid
  type         PaymentTransactionType
  externalId   String?
  status       String
  amountMinor  Int
  rawReference Json?
  createdAt    DateTime               @default(now())

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@index([externalId])
  @@map("payment_transactions")
}

// ============================================================
// NOTIFICATIONS & AUDIT LOGS
// ============================================================

model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @db.Uuid
  type      NotificationType
  title     String
  message   String
  data      Json?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([readAt])
  @@index([createdAt])
  @@map("notifications")
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @db.Uuid
  action    String
  entity    String
  entityId  String?
  before    Json?
  after     Json?
  ipHash    String?
  userAgent String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([entity])
  @@index([createdAt])
  @@map("audit_logs")
}

// ============================================================
// HOMEPAGE CMS & SETTINGS
// ============================================================

model HomeHero {
  id                String   @id @default(uuid()) @db.Uuid
  title             String
  subtitle          String?
  description       String?
  primaryButton     Json?
  secondaryButton   Json?
  backgroundImageId String?  @db.Uuid
  productImageId    String?  @db.Uuid
  isActive          Boolean  @default(true)
  sortOrder         Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  backgroundImage Media? @relation("HomeHeroBg", fields: [backgroundImageId], references: [id], onDelete: SetNull)
  productImage    Media? @relation("HomeHeroProduct", fields: [productImageId], references: [id], onDelete: SetNull)

  @@map("home_heroes")
}

model HomeSection {
  id          String   @id @default(uuid()) @db.Uuid
  type        String
  title       String
  description String?
  imageId     String?  @db.Uuid
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  image Media? @relation("HomeSectionImage", fields: [imageId], references: [id], onDelete: SetNull)

  @@index([type])
  @@index([isActive])
  @@map("home_sections")
}

model SiteSetting {
  id        String      @id @default(uuid()) @db.Uuid
  key       String      @unique
  value     String
  type      SettingType @default(STRING)
  isPublic  Boolean     @default(false)
  updatedAt DateTime    @updatedAt

  @@index([key])
  @@index([isPublic])
  @@map("site_settings")
}
