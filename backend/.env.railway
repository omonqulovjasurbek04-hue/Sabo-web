# ============================================================
# SABO BACKEND — RAILWAY PRODUCTION ENVIRONMENT
# ============================================================

NODE_ENV=production
PORT=4000
API_PREFIX=api/v1
APP_NAME=SABO-API
DEFAULT_LOCALE=uz
SUPPORTED_LOCALES=uz,ru,en

# Database (PostgreSQL - Railway) — template resolves at deploy
DATABASE_URL=postgresql://postgres:uUwglqrboFCwMaRTLkTIGmCeACQZrjiV@${{RAILWAY_PRIVATE_DOMAIN}}:5432/railway?schema=public&connection_limit=20&pool_timeout=10

# Cache & Rate Limiting (Redis) — use Railway Redis service internal URL
REDIS_URL=${{REDIS_URL}}

# Authentication & JWT
JWT_ACCESS_SECRET=sabo_secure_jwt_access_secret_production_key_32_chars_2026
JWT_REFRESH_SECRET=sabo_secure_jwt_refresh_secret_production_key_32_chars_2026
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Initial Super Admin Bootstrapping
ADMIN_BOOTSTRAP_EMAIL=admin@sabo.uz
ADMIN_BOOTSTRAP_PASSWORD=Admin0525

# CORS & Frontend URLs
FRONTEND_URL=https://sabo-web-production.up.railway.app
CORS_ORIGINS=https://sabo-web-production.up.railway.app,https://*.up.railway.app,https://sabo.uz,http://localhost:3000,*

# Feature Flags
ECOMMERCE_ENABLED=true
CART_ENABLED=true
CHECKOUT_ENABLED=true
PAYMENTS_ENABLED=true
BLOG_ENABLED=true
REGISTRATION_ENABLED=true
THREE_D_ENABLED=true